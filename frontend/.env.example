# ── медиаПространство · переменные окружения фронтенда ────────────────────
# Скопируйте в .env.local (разработка) или .env (сервер).
#
# Переменные бэкенда здесь не нужны — они живут в backend/.env.

# Адрес бэкенда, на который проксируются /api/* и /uploads/*.
# Нужен и при сборке, и при работе. В production без него сборка не пройдёт —
# и это сделано намеренно: молча работать с чужим бэкендом хуже, чем упасть.
BACKEND_URL=https://mediahub.example.ru

# Ключ Яндекс.Карт: карта молодёжных центров и выбор места события.
# Без него остальное приложение работает, карты — нет.
NEXT_PUBLIC_YANDEX_MAPS_KEY=

# Прямой адрес API вместо прокси. Нужен только при локальной разработке,
# когда фронтенд и бэкенд запущены раздельно.
# NEXT_PUBLIC_API_URL=http://localhost:8000
