# ── MediaHub Environment Variables ────────────────────────────────────────────
# Копируйте этот файл в .env.local и заполните свои значения

# ── Frontend ─────────────────────────────────────────────────────────────────
# API ключ Яндекс.Карт (обязательно для карт)
NEXT_PUBLIC_YANDEX_MAPS_KEY=your_yandex_maps_api_key_here

# ── Backend (настраиваются на стороне сервера) ────────────────────────────────

# URL для подключения к PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/mediahub

# Секретный ключ для JWT-токенов. Сгенерируйте случайную строку:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Если не задан — при каждом перезапуске генерируется случайный (токены сбрасываются)
# JWT_SECRET=your_random_secret_here

# API-ключ Groq для генерации текстов по шаблонам
# GROQ_API_KEY=gsk_your_groq_key

# ── Brevo (Sendinblue) для email-рассылок ────────────────────────────────────
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=noreply@mediahub.ru
# BREVO_SENDER_NAME=MediaHub

# ── SMTP (альтернатива Brevo) ────────────────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# ── Backend URL (для ссылок в публикациях) ───────────────────────────────────
# BACKEND_URL=https://your-backend.up.railway.app

# ── CORS ─────────────────────────────────────────────────────────────────────
# ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.up.railway.app

# ── VK API ───────────────────────────────────────────────────────────────────
# VK_CLIENT_ID=
# VK_CLIENT_SECRET=
