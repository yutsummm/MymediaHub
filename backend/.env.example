# ── медиаПространство · переменные окружения бэкенда ──────────────────────
# Скопируйте в .env и заполните. Пустые необязательные строки можно удалить.
#
# Полный список того, что читает код. Если здесь чего-то нет — значит код
# этого и не спрашивает.

# ══ Обязательное ══════════════════════════════════════════════════════════

# Подключение к PostgreSQL.
DATABASE_URL=postgresql://mediahub:ПАРОЛЬ@localhost:5432/mediahub

# Подпись токенов входа. Сгенерировать:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Задать один раз и не менять: при смене все входы слетают.
JWT_SECRET=

# Собственный внешний адрес приложения. В соцсети медиа уходит загрузкой, и
# пока файлы лежат в UPLOAD_DIR, этот адрес не нужен вовсе. Он выручает, когда
# файла на диске не оказалось: тогда приложение забирает его у себя же по HTTP.
BACKEND_URL=https://mediahub.example.ru

# Откуда браузеру разрешено обращаться к API — адрес вашего фронтенда.
# Несколько адресов перечисляются через запятую.
ALLOWED_ORIGINS=https://mediahub.example.ru

# Куда складывать загруженные файлы. Каталог должен пережить обновление кода,
# поэтому держите его вне папки с проектом.
UPLOAD_DIR=/var/lib/mediahub/uploads

# ══ Настоятельно рекомендуется ════════════════════════════════════════════

# Ключ шифрования токенов ВК и Telegram в базе. Если не задать, он выводится
# из JWT_SECRET — и тогда смена JWT_SECRET сделает сохранённые токены
# нечитаемыми, интеграции придётся подключать заново. Отдельный ключ
# развязывает эти две вещи. Сгенерировать:
#   python3 -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
TOKEN_ENCRYPTION_KEY=

# Часовой пояс, в котором люди видят и назначают даты.
APP_TZ=Asia/Krasnoyarsk

# ══ Почта — без неё не работает регистрация ═══════════════════════════════
# Регистрация идёт в два шага: аккаунт создаётся только после письма с кодом.
# Нужен либо Brevo, либо SMTP — что-то одно.

BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@mediahub.example.ru
BREVO_SENDER_NAME=медиаПространство

# SMTP как альтернатива Brevo
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ══ Необязательное ════════════════════════════════════════════════════════

# Генерация текстов по шаблонам. Без ключа работает всё, кроме ИИ-помощника.
# https://console.groq.com/keys
GROQ_API_KEY=

# Какую модель просить у Groq. Вынесено в переменную не для гибкости, а по
# необходимости: поставщик выводит модели из обращения без предупреждения, и
# однажды ИИ-помощник просто перестал работать, хотя ключ был исправен.
# Смена модели не должна требовать выкатки.
# Список доступных: https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-20b

# Разово поднимает указанного пользователя до администратора системы.
# Нужен, чтобы войти в свежую установку. После первого входа уберите.
BOOTSTRAP_ADMIN_EMAIL=

# ── Миграции ──────────────────────────────────────────────────────────────
# 1 — схема применяется при старте приложения (нормально для одного процесса).
# 0 — схему двигает `python manage.py migrate` до запуска; так обязательно,
#     если процессов больше одного.
MIGRATE_ON_STARTUP=0

# ── Фоновые циклы ─────────────────────────────────────────────────────────
# Значения по умолчанию подходят почти всем; трогайте, только если знаете зачем.
SCHEDULER_ENABLED=1
SCHEDULER_INTERVAL_SECONDS=60
SCHEDULER_MAX_PER_TICK=10
SCHEDULER_MAX_DELAY_MINUTES=120
PUBLISH_POLL_SECONDS=3
RETENTION_POLL_SECONDS=300
TELEGRAM_STATS_ENABLED=1
TELEGRAM_POLL_SECONDS=300

# ── Прочее ────────────────────────────────────────────────────────────────
# Сколько живёт токен входа, часов.
TOKEN_TTL_HOURS=72
# Сколько действует подписанная ссылка на файл, секунд (12 часов).
UPLOAD_URL_TTL=43200
# text — читаемые логи, json — машинные.
LOG_FORMAT=text
LOG_LEVEL=INFO
# Запрос дольше этого числа миллисекунд помечается в логе как медленный.
SLOW_REQUEST_MS=1000
