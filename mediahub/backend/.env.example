# ── MediaHub Backend Environment Variables ──────────────────────────────
# Копируйте в .env и заполните свои значения

# ── PostgreSQL ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://mediahub:mediahub123@localhost:5432/mediahub

# ── JWT ─────────────────────────────────────────────────────────────────
# Сгенерируйте: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# ── Groq AI (генерация текстов) ────────────────────────────────────────
# https://console.groq.com/keys
GROQ_API_KEY=

# ── Brevo (email-рассылки) ─────────────────────────────────────────────
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@mediahub.ru
BREVO_SENDER_NAME=MediaHub

# ── SMTP (альтернатива Brevo) ──────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── Backend URL (для ссылок в публикациях VK/TG) ───────────────────────
BACKEND_URL=http://localhost:8000

# ── CORS ────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
