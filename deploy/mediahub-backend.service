# API медиаПространства.
#
# Копировать в /etc/systemd/system/, затем:
#   systemctl daemon-reload && systemctl enable --now mediahub-backend

[Unit]
Description=медиаПространство — API
# Требуем базу, а не просто «после сети»: без неё приложение не поднимется,
# и пусть лучше systemd подождёт, чем перезапускает по кругу.
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=exec
User=mediahub
Group=mediahub
WorkingDirectory=/srv/mediahub/backend
EnvironmentFile=/srv/mediahub/backend/.env
ExecStart=/srv/mediahub/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000

# Один процесс намеренно. Планировщик и воркер публикации живут внутри
# приложения: при нескольких воркерах у каждого будет своя копия циклов.
# Они к этому готовы (заявки через publish_attempts и FOR UPDATE SKIP LOCKED),
# но для одного центра это лишняя нагрузка без выигрыша.

Restart=on-failure
RestartSec=5
# Схема двигается отдельной командой, поэтому падение при старте — это
# обычно неверный .env, и перезапускать бесконечно бессмысленно.
StartLimitBurst=5
StartLimitIntervalSec=120

# Загрузки лежат вне каталога с кодом и обязаны быть доступны на запись.
ReadWritePaths=/var/lib/mediahub

# Ограничения. Приложению нужны только свой каталог, база по сети и API соцсетей.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=mediahub-backend

[Install]
WantedBy=multi-user.target
